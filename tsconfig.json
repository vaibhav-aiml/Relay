{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  },
  "references": [
    {
      "path": "packages/shared-types"
    },
    {
      "path": "packages/config"
    },
    {
      "path": "packages/tool-schemas"
    },
    {
      "path": "services/backend"
    }
  ],
  "files": [],
  "extends": "expo/tsconfig.base"
}
