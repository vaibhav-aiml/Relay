# ==========================================
# Relay Backend Environment Variables (.env)
# Never commit the actual .env file to Git!
# ==========================================

# Port & Environment
PORT=4000
NODE_ENV=development

# Firebase Admin (Required for production Firestore & Auth verification)
# Leave empty to run with inMemoryDb fallback during testing/development
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI Providers
# Groq: primary tool-calling model (e.g. llama-3.3-70b-versatile, whisper-large-v3)
GROQ_API_KEY=
# Anthropic: fallback provider (e.g. claude-3-5-sonnet-20241022)
ANTHROPIC_API_KEY=

# Google Workspace OAuth2 (Gmail, Calendar, Contacts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/connections/google/callback

# Security & Encryption (AES-256-GCM 32-byte Base64 key for encrypting OAuth tokens at rest)
TOKEN_ENCRYPTION_KEY=

# Web Search Provider (Optional: Tavily or SerpAPI)
WEB_SEARCH_API_KEY=
