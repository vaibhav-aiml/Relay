{
  "name": "@relay/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "node --max-old-space-size=4096 --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --max-old-space-size=4096 --experimental-vm-modules ../../node_modules/jest/bin/jest.js test/unit --runInBand",
    "test:integration": "node --max-old-space-size=4096 --experimental-vm-modules ../../node_modules/jest/bin/jest.js test/integration --runInBand",
    "test:e2e": "node --max-old-space-size=4096 --experimental-vm-modules ../../node_modules/jest/bin/jest.js test/e2e --runInBand"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@relay/config": "*",
    "@relay/shared-types": "*",
    "@relay/tool-schemas": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "firebase-admin": "^13.1.0",
    "googleapis": "^146.0.0",
    "groq-sdk": "^0.15.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
